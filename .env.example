# DATABASE
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret_password_123
POSTGRES_DB=bookdealers
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SECRETS
GOOGLE_API_KEY=google_key

# ---------- AUTH / JWT ----------
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change_me_generate_a_random_urlsafe_string_64_bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=bookdealers
JWT_AUDIENCE=bookdealers-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Pepper para hashear refresh tokens (no es el mismo que JWT_SECRET)
TOKEN_HASH_SECRET=change_me_generate_another_random_urlsafe_string

# ---------- POLÍTICA DE CONTRASEÑAS ----------
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=true

# ---------- GOOGLE OAUTH ----------
# Client ID de Google (OAuth 2.0 Web). Vacío = Google login desactivado.
GOOGLE_CLIENT_ID=
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# ---------- FUERZA BRUTA / RATE LIMIT ----------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ---------- EMAIL ----------
# Si es false (dev/testing) los tokens de verificación/reset se devuelven en la respuesta.
EMAIL_SEND_ENABLED=false
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:8000

# ---------- TESTS ----------
TEST_DATABASE_NAME=bookdealers_test

# Z3950
Z3950_SERVICE_URL = "http://z3950:8001/search"

# SCHEDULER
EBIBLIO_SYNC_DAYS=7
TODOSTUSLIBROS_SYNC_DAYS=7
LIBRARY_SYNC_DAYS=1
SYNC_EXECUTION_HOUR=2

# FRONTEND (Expo / Metro)
# iPhone físico (dev build): NUNCA localhost — IP LAN del Mac (ipconfig getifaddr en0)
EXPO_PUBLIC_API_URL=http://<IP-LAN-DEL-MAC>:8000
# Host al que el dev client conectará para cargar el bundle (IP LAN de tu máquina para iPhone físico)
REACT_NATIVE_PACKAGER_HOSTNAME=<IP-LAN-DEL-MAC>
