{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["frontend/AGENTS.md"],
  "skills": {
    "paths": ["frontend/.agents/skills"]
  },
  "mcp": {
    "expo": {
      "type": "remote",
      "url": "https://mcp.expo.dev/mcp",
      "enabled": true
    },
    "agent-device": {
      "type": "local",
      "command": ["agent-device", "mcp"],
      "enabled": false
    }
  }
}